# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
# Don't let Reformat Code (Cmd+Alt+L) hard-wrap Markdown — it splits links/bold and breaks rendering
max_line_length = off
ij_markdown_wrap_text_if_long = false
ij_markdown_wrap_text_on_typing = false
